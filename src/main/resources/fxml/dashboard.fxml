<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.novadeskt.controller.DashboardController"
            styleClass="root">

    <top>
        <VBox spacing="8" styleClass="header">
            <padding>
                <Insets top="24"
                        right="28"
                        bottom="24"
                        left="28"/>
            </padding>

            <Label text="NovaDeskt"
                   styleClass="app-title"/>

            <Label text="Votre espace de gestion de projets"
                   styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="28"
                        right="28"
                        bottom="28"
                        left="28"/>
            </padding>

            <VBox spacing="5">
                <Label text="Tableau de bord"
                       styleClass="page-title"/>

                <Label text="Organisez et retrouvez facilement vos projets."
                       styleClass="muted-label"/>
            </VBox>

            <VBox spacing="10">
                <Label text="Créer un projet"
                       styleClass="section-title"/>

                <HBox spacing="10">
                    <TextField fx:id="projectNameField"
                               promptText="Nom du nouveau projet..."
                               onAction="#handleCreateProject"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Créer un projet"
                            onAction="#handleCreateProject"
                            styleClass="primary-button"/>
                </HBox>
            </VBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Mes projets"
                       styleClass="section-title"/>

                <TextField fx:id="searchField"
                           promptText="Rechercher un projet par son nom..."
                           styleClass="search-field"/>

                <ListView fx:id="projectList"
                          VBox.vgrow="ALWAYS"
                          styleClass="project-list"/>

                <Label fx:id="statusLabel"
                       text="Prêt."
                       styleClass="muted-label"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
